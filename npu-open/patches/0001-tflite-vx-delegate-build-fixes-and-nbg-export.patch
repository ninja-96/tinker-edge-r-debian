+
+// rnd/verisilicon: the fast (integer) path of the Vivante NPU wants weights quantised per tensor; TensorFlow 2.x makes int8 weights per channel, which
+// runs on a slow path (MobileNet V2: 134 ms against 6 ms). Per-channel int8 weights and their int32 biases are requantised here to ONE scale (the largest of
+// the channel scales); channels with a smaller scale lose some resolution. VX_REQUANT_PER_CHANNEL=1 switches it on (default: off).
+static bool RequantizePerTensor(const TfLiteTensor* t, std::vector<uint8_t>& out, float* new_scale) {
+  const char* env = getenv("VX_REQUANT_PER_CHANNEL");
+  if (!env || env[0] != '1') return false;   // off unless VX_REQUANT_PER_CHANNEL=1: it costs accuracy where the channel scales differ a lot
+  if (t->quantization.type != kTfLiteAffineQuantization) return false;
+  if (t->type != kTfLiteInt8 && t->type != kTfLiteInt32) return false;
+  const TfLiteAffineQuantization* q = reinterpret_cast<const TfLiteAffineQuantization*>(t->quantization.params);
+  if (!q || !q->scale || q->scale->size <= 1 || !t->data.raw_const) return false;
+  const int n = q->scale->size;
+  const float* sc = q->scale->data;
+  float mx = 0;
+  for (int i = 0; i < n; i++) mx = std::max(mx, sc[i]);
+  if (mx <= 0) return false;
+  const int qd = q->quantized_dimension;
+  size_t inner = 1;
+  for (int i = qd + 1; i < t->dims->size; i++) inner *= t->dims->data[i];
+  out.assign(t->bytes, 0);
+  if (t->type == kTfLiteInt8) {
+    const int8_t* src = reinterpret_cast<const int8_t*>(t->data.raw_const);
+    int8_t* dst = reinterpret_cast<int8_t*>(out.data());
+    for (size_t i = 0; i < t->bytes; i++) {
+      double v = std::round(src[i] * (double)sc[(i / inner) % n] / mx);
+      dst[i] = static_cast<int8_t>(std::max(-127.0, std::min(127.0, v)));
+    }
+  } else {
+    const int32_t* src = reinterpret_cast<const int32_t*>(t->data.raw_const);
+    int32_t* dst = reinterpret_cast<int32_t*>(out.data());
+    for (size_t i = 0; i < t->bytes / 4; i++)
+      dst[i] = static_cast<int32_t>(std::llround(src[i] * (double)sc[(i / inner) % n] / mx));
+  }
+  *new_scale = mx;
+  return true;
+}
