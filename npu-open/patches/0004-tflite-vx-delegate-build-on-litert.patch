tflite-vx-delegate: build on LiteRT

LiteRT (google-ai-edge/LiteRT) carries TensorFlow Lite as tflite/, with its headers under tflite/ (the
TensorFlow tree it takes a few files from still has an older tensorflow/lite/ of its own, which must not be
mixed in). With -DLITERT_SOURCE_DIR the delegate builds LiteRT's tflite/ (TENSORFLOW_SOURCE_DIR: the
TensorFlow tree pinned by LiteRT); the sources include tflite/... instead of tensorflow/lite/...; LiteRT has
no label_image example target.

--- a/cmake/modules/Findtensorflow.cmake
+++ b/cmake/modules/Findtensorflow.cmake
@@ -19,18 +19,23 @@
 #    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
 #    DEALINGS IN THE SOFTWARE
 #
-include(FetchContent)
-FetchContent_Declare(
-  tensorflow
-  GIT_REPOSITORY https://github.com/tensorflow/tensorflow.git
-  GIT_TAG v2.16.1
-)
-FetchContent_GetProperties(tensorflow)
-if(NOT tensorflow_POPULATED)
-  FetchContent_Populate(tensorflow)
+# LiteRT (google-ai-edge/LiteRT): its tflite/ is TensorFlow Lite; it takes a few files of the TensorFlow tree given as TENSORFLOW_SOURCE_DIR
+if(LITERT_SOURCE_DIR)
+  add_subdirectory("${LITERT_SOURCE_DIR}/tflite" "${CMAKE_BINARY_DIR}/tflite")
+else()
+  include(FetchContent)
+  FetchContent_Declare(
+    tensorflow
+    GIT_REPOSITORY https://github.com/tensorflow/tensorflow.git
+    GIT_TAG v2.16.1
+  )
+  FetchContent_GetProperties(tensorflow)
+  if(NOT tensorflow_POPULATED)
+    FetchContent_Populate(tensorflow)
+  endif()
+  add_subdirectory("${tensorflow_SOURCE_DIR}/tensorflow/lite"
+                   "${tensorflow_BINARY_DIR}")
 endif()
-add_subdirectory("${tensorflow_SOURCE_DIR}/tensorflow/lite"
-                 "${tensorflow_BINARY_DIR}")
 get_target_property(TFLITE_SOURCE_DIR tensorflow-lite SOURCE_DIR)
 
 if(TFLITE_LIB_LOC)
