[Unit]
Description=RKNN transfer proxy (host side of the RK3399Pro NPU link)
Requires=npu-firmware.service
After=npu-firmware.service
ConditionPathExists=/usr/bin/npu_transfer_proxy

[Service]
ExecStart=/usr/local/sbin/npu-proxy-run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
