#!/bin/bash
# Choose the device tree variant used at the next boot.
#   tinker-boot-select [base|mpp|npu|full]      (no argument: show variants and the current one)
#   base  mainline V4L2 video drivers, no NPU      (safe default)
#   mpp   Rockchip mpp_service video codec service
#   npu   NPU power sequencing driver
#   full  mpp + npu
# Works with the extlinux boot (/boot/extlinux/extlinux.conf); the previous file is
# kept as extlinux.conf.prev. For the legacy Android boot.img layout it repacks the
# "boot" partition instead.
set -euo pipefail
DT=/boot/dtbs
CONF=/boot/extlinux/extlinux.conf
PART=/dev/disk/by-partlabel/boot

variants() { ls "$DT" | sed 's/^rk3399pro-tinker-edge-r-\?//; s/\.dtb$//; s/^$/base/'; }

if [ $# -ne 1 ]; then
    echo "variants:"; variants | sed 's/^/  /'
    [ -f "$CONF" ] && echo "current: $(grep -m1 -E '^\s*fdt ' "$CONF" | sed 's#.*/rk3399pro-tinker-edge-r-\?##; s/\.dtb//; s/^$/base/')"
    exit 0
fi
v=$1
case "$v" in base) f=$DT/rk3399pro-tinker-edge-r.dtb ;; *) f=$DT/rk3399pro-tinker-edge-r-$v.dtb ;; esac
[ -f "$f" ] || { echo "no such variant: $v" >&2; exit 1; }

if [ -f "$CONF" ]; then
    cp -f "$CONF" "$CONF.prev"
    sed -i -E "s#^(\s*fdt\s+).*#\1$f#" "$CONF"
    echo "extlinux now uses '$v' ($f). Previous: $CONF.prev. Reboot to apply."
    exit 0
fi

# legacy Android boot.img path
[ -b "$PART" ] || { echo "neither $CONF nor the boot partition $PART found" >&2; exit 1; }
mkdir -p /var/lib/tinker
tmp=$(mktemp)
python3 /usr/local/sbin/tinker-mkbootimg --kernel /boot/Image --dtb "$f" -o "$tmp"
size=$(stat -c %s "$tmp"); max=$(blockdev --getsize64 "$PART")
[ "$size" -le "$max" ] || { echo "image ($size) larger than partition ($max)" >&2; exit 1; }
dd if="$PART" of=/var/lib/tinker/boot.prev bs=1M count=$(( (size + 1048575) / 1048576 )) status=none
dd if="$tmp" of="$PART" bs=1M conv=fsync status=none
rm -f "$tmp"
echo "boot partition now uses '$v'. Previous image: /var/lib/tinker/boot.prev. Reboot to apply."
