#!/bin/sh
# Start the RKNN transfer proxy (closed, from Rockchip/ASUS) on a mainline kernel.
# The proxy reads the "Hardware" and "Serial" lines of /proc/cpuinfo, which only the
# vendor 4.4 kernel prints, and silently exits without them. We give it a private copy
# of /proc/cpuinfo (mount namespace of this process only) with those lines added.
# The serial is the USB serial of the NPU die, so the NPU firmware must be running.
set -eu
serial=
for i in $(seq 1 60); do
    for d in /sys/bus/usb/devices/*; do
        [ "$(cat "$d/idVendor" 2>/dev/null)" = 2207 ] || continue
        [ "$(cat "$d/product" 2>/dev/null)" = rk3xxx ] || continue
        serial=$(cat "$d/serial" 2>/dev/null) && break
    done
    [ -n "$serial" ] && break
    sleep 1
done
[ -n "$serial" ] || { echo "npu-proxy-run: no NPU on USB (is npu-firmware running?)" >&2; exit 1; }

mkdir -p /run/npu
{ sed '/^$/d' /proc/cpuinfo
  printf '\nHardware\t: Rockchip RK3399Pro\nSerial\t\t: %s\n' "$serial"
} > /run/npu/cpuinfo
exec unshare -m sh -c 'mount --bind /run/npu/cpuinfo /proc/cpuinfo && exec /usr/bin/npu_transfer_proxy'
