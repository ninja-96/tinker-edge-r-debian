#!/bin/bash
# Grow the root partition (p8) and filesystem to the whole SD card / eMMC, once.
set -euo pipefail
dev=$(findmnt -n -o SOURCE /)
base=$(basename "$dev")
if [ ! -r "/sys/class/block/$base/partition" ]; then
    echo "root is not a partition ($dev), nothing to expand"
    mkdir -p /var/lib/tinker && touch /var/lib/tinker/rootfs-expanded
    exit 0
fi
num=$(cat "/sys/class/block/$base/partition")
disk=/dev/$(lsblk -no PKNAME "$dev")
echo ", +" | sfdisk --no-reread -q -N "$num" "$disk"
partx -u "$disk" || true
resize2fs "$dev"
mkdir -p /var/lib/tinker && touch /var/lib/tinker/rootfs-expanded

# Swap: none on the eMMC (write wear), a 2 GiB swap file when booted from an SD card.
if [ "$(cat "/sys/class/block/$(basename "$disk")/device/type" 2>/dev/null)" = SD ] && [ ! -e /swapfile ]; then
    if fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap -q /swapfile; then
        echo "/swapfile none swap sw 0 0" >> /etc/fstab
        swapon /swapfile || true
    else
        rm -f /swapfile
        echo "could not create the swap file" >&2
    fi
fi
