#!/usr/bin/python3
"""Show the state of the NPU: the chip, the driver of the NPU die, its memory, and the loaded models (npu-models lists them)."""
import sys
try:
    import rk3399pro_npu as npu
    info = npu.info()
except npu.NpuError as e:
    print("NPU: %s" % e)
    sys.exit(1)
print("NPU  chip %x/%x/%x (%s)  driver %s" % (*info["chip"], "supported" if info["chip_ok"] else "NOT supported", info["driver"]))
print("     memory %d MB free of %d MB  |  models loaded: %d" % (info["mem_avail_kb"] // 1024, info["mem_total_kb"] // 1024, info["models"]))
