+/*
+ * Run System ("rs"): make the loader boot the images that were written with wl. Two commands,
+ * as seen on the USB bus when the stock tool does it: WRITE_SDRAM (0x18, sub-code 0xaa) with a
+ * parameter block, then EXECUTE_SDRAM (0x19, sub-code 0xaa) without data.
+ */
+int CRKUsbComm::RKU_RunSystem(BYTE* lpParam, DWORD dwSize)
+{
+	CBW cbw;
+	CSW csw;
+
+	InitializeCBW(&cbw, WRITE_SDRAM);
+	cbw.dwCBWTransferLength = dwSize;
+	cbw.cbwcb.ucReserved = 0xaa;
+	cbw.cbwcb.usLength = EndianU16_LtoB(dwSize);
+	if (!RKU_Write((BYTE *)&cbw, sizeof(CBW)))
+		return ERR_DEVICE_WRITE_FAILED;
+	if (!RKU_Write(lpParam, dwSize))
+		return ERR_DEVICE_WRITE_FAILED;
+	if (!RKU_Read((BYTE *)&csw, sizeof(CSW)))
+		return ERR_DEVICE_READ_FAILED;
+	if (!UFI_CHECK_SIGN(cbw, csw))
+		return ERR_CMD_NOTMATCH;
+
+	InitializeCBW(&cbw, EXECUTE_SDRAM);
+	cbw.cbwcb.ucReserved = 0xaa;
+	if (!RKU_Write((BYTE *)&cbw, sizeof(CBW)))
+		return ERR_DEVICE_WRITE_FAILED;
+	if (!RKU_Read((BYTE *)&csw, sizeof(CSW)))
+		return ERR_DEVICE_READ_FAILED;
+	if (!UFI_CHECK_SIGN(cbw, csw))
+		return ERR_CMD_NOTMATCH;
+	return ERR_SUCCESS;
+}
