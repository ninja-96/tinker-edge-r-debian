+/*
+ * Run System: after the uboot, trust and boot images were written with wl, tell the loader to
+ * start them (used for the NPU die of the RK3399Pro). The parameter block is "RSPM", the
+ * number of images, then per image: type (2 uboot, 1 trust, 4 boot), byte offset
+ * (LBA * 512), size in bytes, 0.
+ */
+bool run_system(STRUCT_RKDEVICE_DESC &dev, char *argv[])
+{
+	if (!check_device_type(dev, RKUSB_LOADER | RKUSB_MASKROM))
+		return false;
+	static const unsigned int types[3] = { 2, 1, 4 };
+	unsigned int blk[2 + 3 * 4];
+	unsigned int i;
+	memset(blk, 0, sizeof(blk));
+	memcpy(&blk[0], "RSPM", 4);
+	blk[1] = 3;
+	for (i = 0; i < 3; i++) {
+		char *pszEnd;
+		unsigned long lba = strtoul(argv[2 + i], &pszEnd, 0);
+		struct stat st;
+		if (*pszEnd || stat(argv[5 + i], &st) != 0) {
+			printf("Run System: bad LBA or file for image %u!\r\n", i + 1);
+			return false;
+		}
+		blk[2 + i * 4 + 0] = types[i];
+		blk[2 + i * 4 + 1] = (unsigned int)(lba * 512);
+		blk[2 + i * 4 + 2] = (unsigned int)st.st_size;
+	}
+	CRKUsbComm *pComm = NULL;
+	bool bRet, bSuccess = false;
+	int iRet;
+	pComm = new CRKUsbComm(dev, g_pLogObject, bRet);
+	if (bRet) {
+		iRet = pComm->RKU_RunSystem((BYTE *)blk, sizeof(blk));
+		if (iRet != ERR_SUCCESS) {
+			if (g_pLogObject)
+				g_pLogObject->Record("Error: RKU_RunSystem failed, err=%d", iRet);
+			printf("Run System failed!\r\n");
+		} else {
+			bSuccess = true;
+			printf("Run System OK.\r\n");
+		}
+	} else {
+		printf("Run System quit, creating comm object failed!\r\n");
+	}
+	if (pComm)
+		delete pComm;
+	return bSuccess;
+}
