# Applied on top of arm64 defconfig. Everything needed to reach the rootfs
# without an initramfs is built in (=y).
CONFIG_ARCH_ROCKCHIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
# Storage
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_PWRSEQ_EMMC=y
CONFIG_PWRSEQ_SIMPLE=y
# PMIC, regulators, clocks, pins
CONFIG_I2C_RK3X=y
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ARM_RK3399_DMC_DEVFREQ=n
# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
# Network (Gigabit Ethernet, Realtek PHY)
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_REALTEK_PHY=y
# USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_TYPEC=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_PCIE_ROCKCHIP_HOST=y
# Display and GPU
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_ROCKCHIP_CDN_DP=y
CONFIG_DRM_PANFROST=m
# Video decode (V4L2 stateless)
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_ROCKCHIP_VDEC=m
CONFIG_VIDEO_HANTRO=m
CONFIG_VIDEO_HANTRO_ROCKCHIP=y
# Audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
# LEDs, input
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_MMC=y
CONFIG_KEYBOARD_ADC=y
# Rockchip MPP video codec service (module; only used with the -mpp DTB)
CONFIG_ROCKCHIP_MPP_SERVICE=m
CONFIG_ROCKCHIP_MPP_RKVDEC=y
CONFIG_ROCKCHIP_MPP_VDPU2=y
CONFIG_ROCKCHIP_MPP_VEPU2=y
# GPIO sysfs and debugfs: needed by the stock ASUS NPU power-control helper
CONFIG_GPIO_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_TINKER_NPU_POWER=m
# No debug info: smaller objects, faster builds (modules are stripped anyway)
CONFIG_DEBUG_INFO_NONE=y
# Wi-Fi: Realtek RTL8822B/C (the stock DT names rtl8822be; PCIe and SDIO variants
# are built because the bus is not confirmed). Bluetooth uses USB (btusb + btrtl).
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822BS=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8822CS=m
